{
  "name": "mattering",
  "version": "0.1.0",
  "private": true,
  "description": "Verifiable sealing and timed disclosure of digital information. Experimental proof of concept; not security reviewed.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:live": "MATTERING_LIVE=1 node --import tsx --test tests/live.test.ts",
    "mattering": "tsx apps/cli/src/main.ts",
    "example": "tsx examples/agent-auction/run.ts",
    "example:verify": "tsx examples/agent-auction/verify.ts",
    "witness": "tsx apps/witness/src/main.ts witness",
    "cosigner": "tsx apps/witness/src/main.ts cosigner",
    "example:hosted": "tsx examples/hosted-registry/run.ts",
    "showcase": "tsx apps/showcase/src/server.ts",
    "showcase:offline": "tsx apps/showcase/src/server.ts offline",
    "build:site": "tsx apps/cloudflare/build.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
